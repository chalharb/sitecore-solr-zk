# =============================================================================
# Sitecore Solr — Environment Variables
# Copy this file to .env and fill in the values for your environment.
# =============================================================================

# --- Kubernetes Context ---
# The kubectl context to use (run `kubectl config get-contexts` to list)
KUBE_CONTEXT=docker-desktop

# Namespace to deploy Solr into
NAMESPACE=solr

# Helm release name
RELEASE_NAME=sitecore

# --- Solr Configuration ---
SOLR_IMAGE_TAG=8.11.2
SOLR_ADMIN_PASSWORD=admin
SOLR_JAVA_MEM="-Xms512m -Xmx1g"

# --- ZooKeeper Configuration ---
# Uses the Pravega ZooKeeper image (required by the ZK Operator)
# Tag 0.2.15 bundles ZooKeeper 3.8.x internally
ZK_IMAGE_TAG=0.2.15

# --- Storage ---
# Leave empty for default storage class (works on Docker Desktop)
# AKS options: managed-premium, managed-csi-premium, default
STORAGE_CLASS=

# --- AKS Deployment (only needed for remote deployments) ---
AKS_RESOURCE_GROUP=
AKS_CLUSTER_NAME=
AKS_SUBSCRIPTION=
