{
  "authentication": {
    "blockUnknown": false,
    "class": "solr.BasicAuthPlugin",
    "credentials": {},
    "realm": "Sitecore Solr",
    "forwardCredentials": false
  },
  "authorization": {
    "class": "solr.RuleBasedAuthorizationPlugin",
    "permissions": [
      { "name": "security-edit",           "role": "admin" },
      { "name": "security-read",           "role": "admin" },
      { "name": "all",                     "role": "admin" },
      { "name": "read",                    "role": ["admin", "sitecore"] },
      { "name": "update",                  "role": ["admin", "sitecore"] },
      { "name": "schema-read",             "role": ["admin", "sitecore"] },
      { "name": "schema-edit",             "role": ["admin", "sitecore"] },
      { "name": "config-read",             "role": ["admin", "sitecore"] },
      { "name": "collection-admin-read",   "role": ["admin", "sitecore"] },
      { "name": "collection-admin-edit",   "role": "admin" }
    ],
    "user-role": {
      "admin":    "admin",
      "sitecore": "sitecore"
    }
  }
}
