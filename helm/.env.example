# =============================================================================
# helm/.env.example
#
# Copy this file to helm/.env and fill in your values.
# helm/.env is excluded from version control (.gitignore).
#
#   cp helm/.env.example helm/.env
#
# These variables are sourced by the deploy scripts:
#   scripts/helm-deploy-local.sh
#   scripts/helm-deploy-aks.sh
# =============================================================================

# -----------------------------------------------------------------------------
# Shared — used by both local and AKS deploys
# -----------------------------------------------------------------------------

# Helm release name
HELM_RELEASE=sitecore-solr

# Kubernetes namespace
K8S_NAMESPACE=sitecore-solr

# Solr collection prefix
SOLR_CORE_PREFIX=sitecore

# -----------------------------------------------------------------------------
# Auth credentials
# IMPORTANT: use strong unique passwords for AKS. The values here are used
# by both the local and AKS deploy scripts via --set flags.
# -----------------------------------------------------------------------------
SOLR_ADMIN_USER=
SOLR_ADMIN_PASSWORD=

SITECORE_SOLR_USER=
SITECORE_SOLR_PASSWORD=

# -----------------------------------------------------------------------------
# Local (Docker Desktop K8s)
# -----------------------------------------------------------------------------
LOCAL_STORAGE_CLASS=hostpath
# LOCAL_STORAGE_CLASS=local-path   # Rancher Desktop / k3s

# -----------------------------------------------------------------------------
# AKS
# -----------------------------------------------------------------------------
AKS_RESOURCE_GROUP=rg-sitecore-solr
AKS_CLUSTER_NAME=aks-sitecore-solr
AKS_STORAGE_CLASS=managed-csi

# Ingress — set to the external IP or your real domain
# Using nip.io for IP-based DNS: solr.<INGRESS_IP>.nip.io
SOLR_INGRESS_HOST=solr.change-me.nip.io

# Set to your TLS secret name once cert-manager is configured, leave blank for HTTP
SOLR_TLS_SECRET=
